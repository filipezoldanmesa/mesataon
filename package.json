{
  "name": "vibra-gestor-oportunidades-prototipo",
  "version": "0.0.1",
  "private": true,
  "description": "Espelho navegável do Gestor de Oportunidades com TODOS os dados mockados — onde o design cria funcionalidades novas antes de virarem task.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
